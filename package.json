{
  "name": "koe",
  "productName": "Hoshidub",
  "version": "0.1.0",
  "description": "Hoshidub: watch anime with a live English dub.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "spike": "electron spike/spike.js",
    "test": "npm run test:unit && npm run test:engine && npm run test:e2e",
    "test:unit": "node --test tests/unit/subtitles.test.js tests/unit/subsync.test.mjs tests/unit/runtime.test.js tests/unit/adopt.test.js",
    "test:engine": "cd engine && ..\\..\\.venv\\Scripts\\python.exe -m pytest tests -q -p no:cacheprovider",
    "test:e2e": "playwright test",
    "icon": "electron tools/make-icon.js",
    "dist": "electron-builder --win nsis",
    "build:hoshi": "esbuild src/ui/js/hoshi3d.src.js --bundle --format=esm --minify --target=chrome130 --outfile=src/ui/js/hoshi3d.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1"
  },
  "author": "MCP Labs",
  "build": {
    "appId": "app.dubit.desktop",
    "productName": "Hoshidub",
    "copyright": "Copyright © 2026 MCP Labs",
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "44.1.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.map",
      "!src/ui/js/hoshi3d.src.js"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "*.py",
          "character/**"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Hoshidub-Setup-${version}.${ext}",
      "legalTrademarks": "Hoshidub is a product of MCP Labs"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hoshidub",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "afterSign": "tools/after-pack.js"
  },
  "dubit": {
    "runtimeBase": "https://grey-woodpecker-803820.hostingersite.com/downloads/runtime",
    "licenseApi": "https://hoshidub.com/api/license",
    "productId": "",
    "checkoutUrl": "https://hoshidub.com/api/checkout.php?plan=monthly"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2"
  }
}
