{
  "name": "koe",
  "productName": "Hoshidub",
  "version": "0.1.0",
  "description": "Hoshidub: watch anime with a live English dub.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "spike": "electron spike/spike.js",
    "test": "npm run test:unit && npm run test:engine && npm run test:e2e",
    "test:unit": "node --test tests/unit/subtitles.test.js tests/unit/subsync.test.mjs tests/unit/runtime.test.js",
    "test:engine": "cd engine && ..\\..\\.venv\\Scripts\\python.exe -m pytest tests -q -p no:cacheprovider",
    "test:e2e": "playwright test",
    "icon": "electron tools/make-icon.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.15.3"
  },
  "author": "MCP Labs",
  "build": {
    "appId": "app.dubit.desktop",
    "productName": "Hoshidub",
    "copyright": "Copyright © 2026 MCP Labs",
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "44.1.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.map"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "*.py"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Dub-It-Setup-${version}.${ext}",
      "legalTrademarks": "Hoshidub is a product of MCP Labs"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hoshidub",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "afterSign": "tools/after-pack.js"
  },
  "dubit": {
    "runtimeBase": ""
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2"
  }
}
