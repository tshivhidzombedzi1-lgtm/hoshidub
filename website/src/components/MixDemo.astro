---
// Hoshidub's sound mix while a line is dubbed: only the Japanese dialogue steps back.
// Numbers are the app's measured values (voice about −15 dB; bass, hi-hats and wide music stay within 2 dB).
const tracks = [
  { name: 'Music', note: 'Full volume', level: 92, db: '0 dB', kind: 'keep' },
  { name: 'Effects', note: 'Full volume', level: 86, db: '−0.5 dB', kind: 'keep' },
  { name: 'Japanese voices', note: 'Stepped back', level: 18, db: '−15 dB', kind: 'duck' },
  { name: 'English voice', note: 'Speaking', level: 88, db: 'New', kind: 'en' },
];
---
<div class="mix glass strong" role="img" aria-label="Sound mix during a dubbed line: music and effects stay at full volume, Japanese voices drop by 15 decibels, and the English voice plays on top.">
  <div class="head"><span class="title">Sound while dubbing</span><span class="chip live">Live</span></div>
  {tracks.map((t, i) => (
    <div class={`track ${t.kind}`} style={`--lv:${t.level}%; --i:${i}`}>
      <div class="meta"><strong>{t.name}</strong><span>{t.note}</span><b>{t.db}</b></div>
      <div class="meter"><i></i></div>
    </div>
  ))}
</div>

<style>
  .mix { width: 100%; max-width: 420px; padding: 20px; border-radius: 24px; display: grid; gap: 16px; }
  .head { display: flex; justify-content: space-between; align-items: center; }
  .title { font-weight: 750; font-size: 18px; }
  .live { background: color-mix(in srgb, var(--success) 20%, transparent); color: var(--text); }
  .track { display: grid; gap: 8px; }
  .meta { display: flex; align-items: baseline; gap: 8px; font-size: 14px; }
  .meta span { color: var(--text-3); font-size: 12px; }
  .meta b { margin-left: auto; font-size: 12px; font-variant-numeric: tabular-nums; color: var(--text-2); }
  .duck .meta b { color: var(--pink); }
  .meter { height: 10px; border-radius: 99px; background: var(--hover); overflow: hidden; }
  .meter i { display: block; height: 100%; width: var(--lv); border-radius: inherit; background: linear-gradient(90deg, var(--blue), var(--violet));
    transform-origin: left; animation: pulse 1.1s ease-in-out infinite alternate; animation-delay: calc(var(--i) * -0.37s); }
  .duck .meter i { background: var(--pink); }
  .en .meter i { background: var(--brand-gradient); }
  @keyframes pulse { from { transform: scaleX(.82); } to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: reduce) { .meter i { animation: none; } }
</style>
