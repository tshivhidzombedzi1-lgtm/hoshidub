---
const { line = "Hi! I'm Hoshi. I'll watch with you, and I promise I'll never spoil a thing.", size = 'hero' } = Astro.props;
---
<figure class={`hoshi-stage ${size}`} data-hoshi>
  <p class="hoshi-say glass strong">{line}</p>
  <div class="hoshi-frame" title="Say hi to Hoshi">
    <img class="hoshi-poster" src="/img/hoshi-poster.webp" width="600" height="840"
         alt="Hoshi, an anime girl with pink twin tails and a dark hoodie with the Hoshidub logo" fetchpriority={size === 'hero' ? 'high' : 'low'} />
  </div>
</figure>

<script>
  // three.js and the 5 MB model load only once a Hoshi stage is on screen
  const stages = document.querySelectorAll('[data-hoshi] .hoshi-frame');
  const mount = (el) => {
    if (el.dataset.mounted) return;
    el.dataset.mounted = '1';
    io.unobserve(el);
    import('../scripts/hoshi-viewer.js').then(({ mountHoshi }) => mountHoshi(el)).catch((err) => console.warn('Hoshi 3D unavailable, showing poster', err));
  };
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) mount(e.target);
  }, { rootMargin: '200px' });
  stages.forEach((s) => {
    io.observe(s);
    // a stage already on screen at load doesn't wait for the observer (it can stall in background tabs)
    if (s.getBoundingClientRect().top < innerHeight + 200) mount(s);
  });
</script>

<style>
  .hoshi-stage { position: relative; margin: 0; display: grid; justify-items: center; align-content: end; }
  .hoshi-frame { position: relative; width: 100%; aspect-ratio: 5 / 7; max-height: 640px; cursor: pointer; }
  .hoshi-stage.small .hoshi-frame { max-height: 460px; }
  .hoshi-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity 600ms; }
  .hoshi-frame.is-live .hoshi-poster { opacity: 0; }
  .hoshi-frame :global(.hoshi-canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .hoshi-say { position: relative; z-index: 3; max-width: 300px; margin: 0 0 -10px; padding: 12px 16px; border-radius: 18px; font-size: 15px; line-height: 1.4;
    animation: pop 600ms var(--ease-out) 400ms both; }
  .hoshi-say::after { content: ""; position: absolute; left: 50%; bottom: -8px; width: 16px; height: 16px; transform: translateX(-50%) rotate(45deg);
    background: var(--glass-tint-strong); z-index: -1; }
  @keyframes pop { from { opacity: 0; transform: translateY(10px) scale(0.96); } }
</style>
