---
const { size = 32 } = Astro.props;
---
<svg class="logo-mark" width={size} height={size} viewBox="0 0 512 512" aria-hidden="true">
  <defs>
    <linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ff6b9d" /><stop offset="0.55" stop-color="#c38bff" /><stop offset="1" stop-color="#6ba8ff" />
    </linearGradient>
  </defs>
  <rect x="16" y="16" width="480" height="480" rx="112" fill="url(#lg)" />
  <g fill="#fff">
    <rect x="118" y="214" width="40" height="84" rx="20" /><rect x="186" y="150" width="40" height="212" rx="20" />
    <rect x="254" y="110" width="40" height="292" rx="20" /><rect x="322" y="170" width="40" height="172" rx="20" />
    <rect x="390" y="224" width="40" height="64" rx="20" opacity="0.85" />
  </g>
</svg>
