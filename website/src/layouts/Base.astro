---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { site, links, founder } from '../config.js';

const { title, description = site.description, image = '/img/og.png', jsonld = null } = Astro.props;
const pageTitle = title ? `${title} · Hoshidub` : `Hoshidub: ${site.slogan}`;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  ['/#features', 'Features'], ['/#hoshi', 'Hoshi'], ['/pricing', 'Pricing'], ['/#faq', 'FAQ'], ['/about', 'About'],
];
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'MCP Labs', url: site.url,
  logo: `${site.url}/img/icon-512.png`, address: { '@type': 'PostalAddress', addressLocality: 'Pretoria', addressCountry: 'ZA' },
  founder: { '@type': 'Person', name: 'Tshivhidzo Mbedzi', alternateName: 'Moss' }, sameAs: [links.linkedin, links.youtube],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/img/icon-512.png" />
  <link rel="preload" href="/fonts/Inter.woff2" as="font" type="font/woff2" crossorigin />
  <meta name="theme-color" content="#0c0c12" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#eef0f6" media="(prefers-color-scheme: light)" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Hoshidub" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, site.url).toString()} />
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline src="/theme.js"></script>
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="backdrop" aria-hidden="true">
    <i></i><i></i><i></i>
    <svg viewBox="0 0 1440 400" preserveAspectRatio="none">
      <path d="M0 400 L0 300 C160 270 240 240 330 250 C420 262 470 210 560 200 L720 60 L880 200 C970 210 1020 262 1110 250 C1200 240 1280 270 1440 300 L1440 400 Z" fill="var(--text)" opacity="0.35" />
      <path d="M660 115 L720 60 L780 115 C760 108 745 124 720 112 C695 124 680 108 660 115 Z" fill="var(--text)" opacity="0.7" />
    </svg>
  </div>

  <header class="nav-wrap">
    <nav class="nav glass wrap-nav" aria-label="Main">
      <a class="brand" href="/" aria-label="Hoshidub home"><Logo size={30} /><span>Hoshidub</span></a>
      <ul class="nav-links">
        {nav.map(([href, label]) => <li><a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a></li>)}
      </ul>
      <div class="nav-end">
        <button class="theme-btn" id="theme-btn" type="button" aria-label="Switch light or dark theme">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
        </button>
        <a class="btn primary nav-cta" href="/download">Download</a>
        <details class="menu">
          <summary aria-label="Menu"><span></span><span></span></summary>
          <div class="menu-panel glass strong">
            {nav.map(([href, label]) => <a href={href}>{label}</a>)}
            <a href="/tip">Support us</a>
            <a href={links.account} target="_blank" rel="noopener">My account</a>
            <a class="btn primary" href="/download">Download for Windows</a>
          </div>
        </details>
      </div>
    </nav>
  </header>

  <main id="main"><slot /></main>

  <footer class="footer">
    <div class="wrap footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/"><Logo size={28} /><span>Hoshidub</span></a>
        <p class="small">{site.slogan}</p>
        <p class="small">Hoshidub is a product of <strong>MCP Labs</strong>.<br />Created by <a href="/about">{founder.name}</a>, {founder.place}.</p>
      </div>
      <div>
        <h3 class="foot-h">Product</h3>
        <a href="/#features">Features</a><a href="/#hoshi">Meet Hoshi</a><a href="/pricing">Pricing</a><a href="/download">Download</a><a href={links.account} target="_blank" rel="noopener">My account</a>
      </div>
      <div>
        <h3 class="foot-h">Company</h3>
        <a href="/about">About</a><a href="/tip">Support us</a><a href="/press">Press kit</a><a href="/support">Help</a>
      </div>
      <div>
        <h3 class="foot-h">Follow</h3>
        <a href={links.discord} rel="noopener" target="_blank">Discord</a>
        <a href={links.youtube} rel="noopener" target="_blank">YouTube</a>
        <a href={links.linkedin} rel="noopener" target="_blank">LinkedIn</a>
      </div>
    </div>
    <div class="wrap footer-base">
      <p class="small">© 2026 MCP Labs. <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
      <p class="small">Hoshidub is not affiliated with any streaming service. All trademarks belong to their owners.</p>
    </div>
  </footer>

  <script>
    const btn = document.getElementById('theme-btn');
    btn?.addEventListener('click', () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch { /* storage blocked */ }
    });
  </script>
</body>
</html>

<style is:global>
  .skip { position: absolute; left: -999px; top: 8px; z-index: 100; padding: 10px 16px; border-radius: 10px; background: var(--accent); color: #fff; }
  .skip:focus { left: 16px; }
  .nav-wrap { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50; padding: 12px var(--gutter) 0; }
  .wrap-nav { max-width: var(--wrap); margin-inline: auto; }
  .nav { display: flex; align-items: center; gap: 20px; padding: 8px 8px 8px 16px; border-radius: 999px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 750; font-size: 18px; letter-spacing: -0.02em; color: var(--text); text-decoration: none !important; }
  .nav-links { display: flex; gap: 4px; list-style: none; margin: 0 auto; padding: 0; }
  .nav-links a { display: block; padding: 8px 14px; border-radius: 999px; color: var(--text-2); font-weight: 550; font-size: 15px; text-decoration: none; }
  .nav-links a:hover, .nav-links a[aria-current] { background: var(--hover); color: var(--text); }
  .nav-end { display: flex; align-items: center; gap: 6px; margin-left: auto; }
  .nav-cta { min-height: 40px; padding: 0 18px; font-size: 15px; }
  .theme-btn { width: 40px; height: 40px; border: 0; border-radius: 50%; background: transparent; color: var(--text); cursor: pointer; display: grid; place-items: center; }
  .theme-btn:hover { background: var(--hover); }
  .theme-btn svg { width: 20px; height: 20px; }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; width: 44px; height: 44px; border-radius: 50%; display: grid; place-content: center; gap: 6px; cursor: pointer; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary span { display: block; width: 20px; height: 2px; border-radius: 2px; background: var(--text); }
  .menu-panel { position: absolute; right: 0; top: 54px; width: min(280px, calc(100vw - 32px)); padding: 12px; display: grid; gap: 4px; border-radius: 22px; }
  .menu-panel a:not(.btn) { padding: 12px 14px; border-radius: 12px; color: var(--text); font-weight: 600; }
  .menu-panel a:not(.btn):hover { background: var(--hover); text-decoration: none; }
  @media (max-width: 860px) { .nav-links, .nav-cta { display: none; } .menu { display: block; } }
  .footer { margin-top: 40px; padding: 56px 0 40px; border-top: 1px solid var(--line); background: color-mix(in srgb, var(--base) 60%, transparent); }
  .footer-grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 32px; }
  .footer-grid > div { display: grid; gap: 10px; align-content: start; }
  .footer-grid a:not(.brand) { color: var(--text-2); font-size: 15px; }
  .foot-h { font-size: 13px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); margin-bottom: 4px; }
  .footer-brand { gap: 12px !important; }
  .footer-base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--line); }
  @media (max-width: 760px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-brand { grid-column: 1 / -1; } }
</style>
